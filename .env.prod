TZ=UTC
NODE_ENV=production

NOTAS_STAGE=prod
NOTAS_ROOT=/opt/notas

# a value the operator provides always wins over this file; left empty, the default from `Env.Defaults` applies
NOTAS_TIMEZONE=
NOTAS_LOGGING=
NOTAS_UPLOAD_LIMIT=
INTERACTIVE_DEMO=
# required, and without a default: a bcrypt hash of the admin's password, e.g. from
#   bun -e 'console.log(await Bun.password.hash(prompt("password:"), "bcrypt"))'
# provided as an environment variable, it goes as is; written in this file instead, every $ needs escaping as \$
NOTAS_ADMIN_PASSWORD=
